{{- if eq .chezmoi.hostname "home-desktop" }}
$fileName = "D:\Documents\PowerShell\profile.ps1"
{{- else if eq .chezmoi.hostname "bme-desktop" }}
$fileName = "~\Documents\PowerShell\profile.ps1"
{{- end }}

# SRC_DIR is set in chezmoi config file.
cat (Join-Path -Path $env:SRC_DIR ".chezmoitemplates\pwsh_profile") | chezmoi execute-template --output=$fileName
