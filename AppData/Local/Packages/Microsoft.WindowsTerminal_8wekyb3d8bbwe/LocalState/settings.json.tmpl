{{ if eq .chezmoi.hostname "home-desktop" }}
    {{- template "windows_terminal_base" dict 
        "colorscheme_light" "Gruvbox Light"
        "colorscheme_dark"  "Gruvbox Dark"
    -}}
{{ else if (or (eq .chezmoi.hostname "home-laptop") (eq .chezmoi.hostname "bme-laptop")) }}
    {{- template "windows_terminal_base" dict 
        "colorscheme_light" "Everforest Light Medium"
        "colorscheme_dark"  "Everforest Dark Medium"
    -}}
{{ else if eq .chezmoi.hostname "bme-desktop" }}
    {{- template "windows_terminal_base" dict 
        "colorscheme_light" "Catppuccin Macchiato"
        "colorscheme_dark"  "Catppuccin Macchiato"
    -}}
{{ end }}
