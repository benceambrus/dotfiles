" Theme
set theme auto

" Hint setup
set hintchars qweruiopasdfjklé
set hintfiltermode simple
set hintnames short

" Search engine
set searchurls.startpage https://www.startpage.com/sp/search?query=%s
" MTA helyesírás
set searchurls.he https://www.helyesiras.mta.hu/helyesiras/default/suggest?q=%s
" MTA külőn vagy egybe
set searchurls.ke https://www.helyesiras.mta.hu/helyesiras/default/kulegy?q=%s
" Youtube
set searchurls.yt https://www.youtube.com/results?search_query=%s
" set searchengine startpage

" Global bindings
"" Bind for sourcing the config
bind <CA-r> source --url https://raw.githubusercontent.com/benceambrus/dotfiles/refs/heads/main/dot_config/tridactyl/tridactylrc
bind <CA-l> source ~/.config/tridactyl/tridactylrc

"" Set smooth scrolling
set smoothscroll true
bind j scrollline 7
bind k scrollline -7
bind h scrollpx -100
bind l scrollpx 100

"" Switch up tab switch
bind J tabnext
bind K tabprev

"" Tab detach into new window
bind gd tabdetach
bind gD composite tabduplicate; tabdetach

"" Hint to focus on element
bind ;; hint -;

" Website shortcuts
bind ge tabopen edu.epito.bme.hu
bind gn tabopen neptun.bme.hu/oktatoi/login.aspx
bind gm tabopen -c Music www.youtube.com
bind gy winopen youtube.com/playlist?list=WL

"" Edu - Go to Grades
bind gj js tri.xpath = ("//span[text()='Grades']/.."); tri.res = document.evaluate(tri.xpath, document, null, XPathResult.ORDERED_NODE_SNAPSHOT_TYPE, null).snapshotItem(1); tri.res.click();

"" Search engines
" bindurl www.startpage.com f hint -Jc .w-gl__result-title,button,input
" bindurl www.startpage.com F hint -bJc .w-gl__result-title,button,input

"" Youtube
" bindurl www.youtube.com f hint -Jc yt-formatted-string,yt-icon,[id='video-title'],[id='search'],tp-yt-paper-button,tp-yt-paper-tab
" bindurl www.youtube.com ;q hint -Jc yt-formatted-string -W js -p tri.excmds.shellescape(JS_ARG).then(url => tri.excmds.exclaim_quiet('streamlink ' + url))

"" Twitch
" bindurl www.twitch.tv f hint -Jc a,input
" Show only videos for opening in streamlink
" bindurl www.twitch.tv ;q hint -Jc div[class^='Layout'] > article > div[class^='Layout'] a[data-focusable='true'],nav[id='side-nav'] a -W js -p tri.excmds.shellescape(JS_ARG).then(url => tri.excmds.exclaim_quiet('streamlink ' + url))

""  Inoreader
bindurl www.inoreader.com hint -J [class*="title_link"],[title*="Read later"],[id*="linkdiv"]

" Unbinds
unbind <C-e> " originally: scrollline 10
unbind . " originally: repeat last action

