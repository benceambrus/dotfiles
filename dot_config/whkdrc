.shell powershell

# Restart komorebi, komorebi-bar and whkd
# alt + o               : taskkill /f /im whkd.exe && start /b whkd # if shell is cmd
win + shift + x         : Stop-Process -Name "komorebi","komorebi-bar","whkd"; Start-Process komorebic -ArgumentList "start","--bar","--whkd" -WindowStyle Hidden

# Reload configuration
win + shift + i         : komorebic reload-configuration

# Restart whkd
win + shift + ctrl + x  : Stop-Process -Name "whkd"; Start-Process "whkd" -WindowStyle Hidden

# App shortcuts - these require shell to be pwsh / powershell
# The apps will be focused if open, or launched if not open
# alt + f                 : if ($wshell.AppActivate('Firefox') -eq $False) { start firefox }
# alt + b                 : if ($wshell.AppActivate('Chrome') -eq $False) { start chrome }

# Open WHKD config file in Neovim
win + z		         	: Start-Process nvim -ArgumentList (Join-Path -Path $env:USERPROFILE -ChildPath ".config/whkdrc")

# Open Windows terminal
win + return            : Start-Process wt

win + x                 : komorebic close
win + c                 : komorebic minimize

# Focus windows
win + h                 : komorebic focus left
win + j                 : komorebic focus down
win + k                 : komorebic focus up
win + l                 : komorebic focus right
win + b                 : komorebic cycle-focus next
win + shift + b         : komorebic cycle-focus previous
# alt + shift + oem_4   : komorebic cycle-focus previous # oem_4 is [
# alt + shift + oem_6   : komorebic cycle-focus next # oem_6 is ]

# Cycle layouts
win + y                 : komorebic cycle-layout next
win + shift + y         : komorebic cycle-layout previous

# Move windows
win + shift + h         : komorebic move left
win + shift + j         : komorebic move down
win + shift + k         : komorebic move up
win + shift + l         : komorebic move right
win + shift + return    : komorebic promote

# Stack windows
win + ctrl + h          : komorebic stack left
win + ctrl + j          : komorebic stack down
win + ctrl + k          : komorebic stack up
win + ctrl + l          : komorebic stack right
win + ctrl + c          : komorebic unstack # oem_1 is ;
win + ctrl + y          : komorebic cycle-stack previous # oem_4 is [
win + ctrl + x          : komorebic cycle-stack next # oem_6 is ]
win + ctrl + q          : komorebic stack-all
win + ctrl + w          : komorebic unstack-all

# Resize
win + u                 : komorebic resize-axis horizontal increase
win + p                 : komorebic resize-axis horizontal decrease
win + i                 : komorebic resize-axis vertical increase
win + o                 : komorebic resize-axis vertical decrease

# Manipulate windows
win + t                 : komorebic toggle-float
win + g                 : komorebic toggle-monocle

# Window manager options
win + shift + o          : komorebic retile
win + shift + p          : komorebic toggle-pause

# Layouts
win + q                 : komorebic flip-layout horizontal
win + shift + q         : komorebic flip-layout vertical

# Workspaces
win + 1                 : komorebic focus-workspace 0
win + 2                 : komorebic focus-workspace 1
win + 3                 : komorebic focus-workspace 2
win + 4                 : komorebic focus-workspace 3
win + 5                 : komorebic focus-workspace 4
win + 6                 : komorebic focus-workspace 5
win + 7                 : komorebic focus-workspace 6
win + 8                 : komorebic focus-workspace 7
win + tab               : komorebic cycle-workspace next
win + shift + tab       : komorebic cycle-workspace previous
win + ctrl + tab        : komorebic focus-last-workspace

# Focus workspace on every monitor
win + ctrl + 1          : komorebic focus-workspaces 0 
win + ctrl + 2          : komorebic focus-workspaces 1 
win + ctrl + 3          : komorebic focus-workspaces 2 

# Move windows across workspaces
win + shift + 1         : komorebic move-to-workspace 0
win + shift + 2         : komorebic move-to-workspace 1
win + shift + 3         : komorebic move-to-workspace 2
win + shift + 4         : komorebic move-to-workspace 3
win + shift + 5         : komorebic move-to-workspace 4
win + shift + 6         : komorebic move-to-workspace 5
win + shift + 7         : komorebic move-to-workspace 6
win + shift + 8         : komorebic move-to-workspace 7
win + escape            : komorebic cycle-move-to-workspace next
win + shift + escape    : komorebic cycle-move-to-workspace previous

# Switch monitors and move workspaces
win + m                   : komorebic focus-monitor 1
win + oem_comma           : komorebic focus-monitor 0
win + oem_period          : komorebic focus-monitor 2
win + shift + m           : komorebic move-to-monitor 1
win + shift + oem_comma   : komorebic move-to-monitor 0
win + shift + oem_period  : komorebic move-to-monitor 2

