.shell powershell

# Restart komorebi, komorebi-bar and whkd
# alt + o               : taskkill /f /im whkd.exe && start /b whkd # if shell is cmd
alt + shift + x         : Stop-Process -Name "komorebi","komorebi-bar","masir"
alt + shift + u         : Start-Process "komorebi" -WindowStyle Hidden
alt + shift + i         : Stop-Process -Name "whkd"; Start-Process "whkd" -WindowStyle Hidden
alt + shift + o         : Start-Process "masir" -WindowStyle Hidden
alt + shift + p         : Start-Process "komorebi-bar" -WindowStyle Hidden

# Reload configuration
# alt + shift + r         : komorebic reload-configuration

# Restart whkd
alt + shift + ctrl + x  : Stop-Process -Name "whkd"; Start-Process "whkd" -WindowStyle Hidden

# App shortcuts - these require shell to be pwsh / powershell
# The apps will be focused if open, or launched if not open
# alt + f                 : if ($wshell.AppActivate('Firefox') -eq $False) { start firefox }
# alt + b                 : if ($wshell.AppActivate('Chrome') -eq $False) { start chrome }

# Open WHKD config file in Neovim
alt + z                 : Start-Process nvim -ArgumentList (Join-Path -Path $env:USERPROFILE -ChildPath ".config/whkdrc")

# Open Windows terminal
alt + return            : Start-Process wt

alt + x                 : komorebic close
alt + c                 : komorebic minimize

# Focus windows
alt + h                 : komorebic focus left
alt + j                 : komorebic focus down
alt + k                 : komorebic focus up
alt + l                 : komorebic focus right
# alt + oem_1             : komorebic focus right
alt + b                 : komorebic cycle-focus next
alt + shift + b         : komorebic cycle-focus previous
# alt + shift + oem_4   : komorebic cycle-focus previous # oem_4 is [
# alt + shift + oem_6   : komorebic cycle-focus next # oem_6 is ]

# Cycle layouts
alt + y                 : komorebic cycle-layout next
alt + shift + y         : komorebic cycle-layout previous

# Move windows
alt + shift + h         : komorebic move left
alt + shift + j         : komorebic move down
alt + shift + k         : komorebic move up
alt + shift + l     : komorebic move right
# alt + shift + oem_1     : komorebic move right
alt + shift + return    : komorebic promote

# Stack windows
alt + win + h          : komorebic stack left
alt + win + j          : komorebic stack down
alt + win + k          : komorebic stack up
alt + win + l          : komorebic stack right
# alt + ctrl + oem_1      : komorebic stack right
alt + win + c          : komorebic unstack # oem_1 is ;
alt + win + y          : komorebic cycle-stack previous # oem_4 is [
alt + win + x          : komorebic cycle-stack next # oem_6 is ]
alt + win + q          : komorebic stack-all
alt + win + w          : komorebic unstack-all

# Resize
alt + u                 : komorebic resize-axis horizontal increase
alt + p                 : komorebic resize-axis horizontal decrease
alt + i                 : komorebic resize-axis vertical increase
alt + o                 : komorebic resize-axis vertical decrease

# Manipulate windows
alt + t                 : komorebic toggle-float
alt + g                 : komorebic toggle-monocle

# Window manager options
alt + shift + t          : komorebic retile
alt + shift + g          : komorebic toggle-pause

# Layouts
alt + q                 : komorebic flip-layout horizontal
alt + shift + q         : komorebic flip-layout vertical

# Workspaces
alt + 1                 : komorebic focus-workspace 0
alt + 2                 : komorebic focus-workspace 1
alt + 3                 : komorebic focus-workspace 2
alt + 4                 : komorebic focus-workspace 3
alt + 5                 : komorebic focus-workspace 4
alt + 6                 : komorebic focus-workspace 5
alt + 7                 : komorebic focus-workspace 6
alt + 8                 : komorebic focus-workspace 7
alt + r                 : komorebic cycle-workspace next
alt + e                 : komorebic cycle-workspace previous
win + tab               : komorebic focus-last-workspace

# Focus workspace on every monitor
alt + win + 1          : komorebic focus-workspaces 0 
alt + win + 2          : komorebic focus-workspaces 1 
alt + win + 3          : komorebic focus-workspaces 2 

# Move windows across workspaces
alt + shift + 1         : komorebic move-to-workspace 0
alt + shift + 2         : komorebic move-to-workspace 1
alt + shift + 3         : komorebic move-to-workspace 2
alt + shift + 4         : komorebic move-to-workspace 3
alt + shift + 5         : komorebic move-to-workspace 4
alt + shift + 6         : komorebic move-to-workspace 5
alt + shift + 7         : komorebic move-to-workspace 6
alt + shift + 8         : komorebic move-to-workspace 7
alt + shift + r         : komorebic cycle-move-to-workspace next
alt + shift + e         : komorebic cycle-move-to-workspace previous

# Switch monitors and move workspaces
alt + m                   : komorebic focus-monitor 0
alt + oem_comma           : komorebic focus-monitor 1
alt + oem_period          : komorebic focus-monitor 2
alt + shift + m           : komorebic move-to-monitor 0
alt + shift + oem_comma   : komorebic move-to-monitor 1
alt + shift + oem_period  : komorebic move-to-monitor 2

