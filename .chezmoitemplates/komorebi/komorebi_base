{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.33/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "display_index_preferences": { {{- template "komorebi/display_preferences" . -}} },
  "default_workspace_padding": 0,
  "default_container_padding": 0,
  "border": true,
  "border_width": 3,
  "border_offset": -1,
  "manage_rules": [
    {
      "kind": "Exe",
      "id": "MATLAB.exe",
      "matching_strategy": "Equals"
    }
  ],
  "theme": {{- template "komorebi/theme" . -}},
  "bar_configurations": [ {{- template "komorebi/bar_config" . -}} ],
  "stackbar": {
    "height": 20,
    "mode": "OnStack",
    "label": "Title",
    "tabs": {
      "width": 250,
      "font_family": "Cascadia Code",
      "font_size": 12,
      "focused_text": "#8e64a6",
      "unfocused_text": "#b3b3b3",
      "background": "#141414"
    }
  },
  "monitors": [ {{- template "komorebi/workspaces" . -}}]
}
