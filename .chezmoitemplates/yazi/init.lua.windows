-- Relative relative-motions
require("relative-motions"):setup({
	show_numbers = "relative",
	show_motion = true,
	enter_mode = "first",
})

-- Projects
require("projects"):setup({
	save = {
		method = "lua", -- yazi | lua
		-- lua_save_path = "", -- comment out to get the default value
		-- windows: "%APPDATA%/yazi/state/projects.json"
		-- unix: "~/.local/state/yazi/projects.json"
	},
	last = {
		update_after_save = true,
		update_after_load = true,
		load_after_start = false,
	},
	merge = {
		quit_after_merge = false,
	},
	notify = {
		enable = true,
		title = "Projects",
		timeout = 3,
		level = "info",
	},
})

-- Bunny
local user_dir = os.getenv("USERPROFILE")
local username = os.getenv("USERNAME")
{{ if eq .chezmoi.hostname "bme-laptop" }}
local download_dir = "C:/Users/ambrus/Downloads/"
local cloud_root = "C:/Users/ambrus/Cloud/"
{{ else }}
local download_dir = "D:/Downloads/"
local cloud_root = "D:/Cloud/"
{{ end }}

require("bunny"):setup({
	hops = {
		{ key = { "d", "d" }, path = "D:/", desc = "Drive: D" },
		{ key = { "d", "c" }, path = "C:/", desc = "Drive: C" },
		{ key = { "d", "w" }, path = "\\\\wsl.localhost\\Ubuntu\\home\\" .. username, desc = "WSL: Ubuntu" },
		{ key = { "h", "c" }, path = user_dir .. "/.config", desc = "Config" },
		{ key = { "h", "a" }, path = user_dir .. "/AppData", desc = "AppData" },
		{ key = { "h", "d" }, path = user_dir .. "/.local/share/chezmoi", desc = "chezmoi" },
		{ key = { "h", "w" }, path = download_dir },
		{ key = { "c", "b" }, path = cloud_root .. "OneDrive - Budapesti Műszaki és Gazdaságtudományi Egyetem", desc = "OneDrive: BME" },
		{ key = { "c", "p" }, path = cloud_root .. "OneDrive/", desc = "OneDrive: Personal" },
		{ key = { "c", "e" }, path = cloud_root .. "OneDrive - epito.bme.hu/", desc = "OneDrive: epito" },
		{ key = { "w", "c" }, path = cloud_root .. "OneDrive - Budapesti Műszaki és Gazdaságtudományi Egyetem/Egyetem/Kurzusok/", desc = "Work: Courses" },
		{ key = { "w", "g" }, path = cloud_root .. "OneDrive - Budapesti Műszaki és Gazdaságtudományi Egyetem/Egyetem/Kurzusok/gnss_application_and_theory/2026", desc = "Work: Courses/GNSS" },
		{ key = { "w", "u" }, path = cloud_root .. "OneDrive - Budapesti Műszaki és Gazdaságtudományi Egyetem/Egyetem/Kurzusok/urnavigacio/2025", desc = "Work: Courses/Urnavi" },
		{ key = { "w", "s" }, path = cloud_root .. "OneDrive - Budapesti Műszaki és Gazdaságtudományi Egyetem/Egyetem/Kurzusok/geodezia_2", desc = "Work: Courses/Geodezia_2" },
		-- key and path attributes are required, desc is optional
	},
	desc_strategy = "path", -- If desc isn't present, use "path" or "filename", default is "path"
	notify = false, -- Notify after hopping, default is false
	fuzzy_cmd = "fzf", -- Fuzzy searching command, default is "fzf"
})
