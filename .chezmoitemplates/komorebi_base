{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.33/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "display_index_preferences": { {{ .display_index_preferences }} },
  "default_workspace_padding": 0,
  "default_container_padding": 0,
  "border": true,
  "border_width": 6,
  "border_offset": -1,
  "theme": {
    "name": "{{ .theme_name }}",
    "palette": "{{ .theme_palette }}",
    "unfocused_border": "{{ .theme_unfocused_border }}",
    "bar_accent": "{{ .theme_bar_accent }}",
    "floating_border": "{{ .theme_floating_border }}",
    "single_border": "{{ .theme_single_border }}",
    "stack_border": "{{ .theme_stack_border }}"
  },
  "bar_configurations": [ "{{ .bar_configs }}" ],
  "stackbar": {
    "height": 15,
    "mode": "OnStack",
    "label": "Title",
    "tabs": {
      "width": 300,
      "font_family": "Cascadia Code",
      "font_size": 12,
      "focused_text": "#8e64a6",
      "unfocused_text": "#b3b3b3",
      "background": "#141414"
    }
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "WEB",
          "layout": "BSP",
        },
        {
          "name": "EXP",
          "layout": "BSP",
          "workspace_rules": [
            {
                "kind": "Exe",
                "id": "TOTALCMD64.EXE"
            }
          ]
        },
        {
          "name": "CMD",
          "layout": "BSP",
          "workspace_rules": [
            {
                "kind": "Exe",
                "id": "wezterm-gui.exe"
              }
          ]
        },
        {
          "name": "COD",
          "layout": "BSP",
          "workspace_rules": [
            {
                "kind": "Exe",
                "id": "Code.exe"
              }
          ]
        },
        {
          "name": "V",
          "layout": "BSP"
        },
        {
          "name": "VI",
          "layout": "BSP"
        },
        {
          "name": "VII",
          "layout": "BSP"
        }
      ]
    },
    {
      "workspaces": [
        {
          "name": "A",
          "layout": "Rows"
        },
        {
          "name": "B",
          "layout": "Rows"
        },
        {
          "name": "C",
          "layout": "Rows"
        },
        {
          "name": "D",
          "layout": "Rows"
        }
      ]
    },
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "Grid"
        },
        {
          "name": "2",
          "layout": "Grid"
        },
        {
          "name": "3",
          "layout": "Grid"
        },
        {
          "name": "4",
          "layout": "Grid"
        }
      ]
    }
  ]
}
